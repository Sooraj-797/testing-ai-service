{
  "name": "testing-ai-service",
  "version": "1.0.0",
  "description": "A microservices-based backend system",
  "author": "YourName",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "typeorm:platform": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./libs/database/src/orms/platform-orm-config.ts",
    "migration:platform:generate": "npm run typeorm:platform migration:generate -o ./libs/database/src/migrations/platform/migration",
    "migration:platform:run": "npm run typeorm:platform migration:run",
    "migration:platform:revert": "npm run typeorm:platform migration:revert",
    "typeorm:tenant": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./libs/database/src/orms/tenant-orm-config.ts",
    "migration:tenant:generate": "cross-env TENANT_DB=$npm_config_db npm run typeorm:tenant migration:generate -o ./libs/database/src/migrations/tenant/migration",
    "migration:tenant:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create ./libs/database/src/migrations/tenant/migration",
    "migration:tenant:run": "ts-node ./libs/database/src/scripts/run-tenant-migrations.ts",
    "migration:tenant:revert": "ts-node ./libs/database/src/scripts/revert-tenant-migrations.ts",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "env-cmd -f .env nest start",
    "start:user": "nest start user-service",
    "start:product": "nest start product-service",
    "start:dev": "env-cmd -f .env nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "env-cmd -f .env nest start",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --detectOpenHandles --forceExit --maxWorkers=100% --ci --reporters=default --reporters=jest-junit --coverage --coverageReporters=lcov --coverageReporters=cobertura --coverageReporters=text --coverageReporters=text-summary --coverageDirectory=coverage",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "encrypt-db-credentials": "ts-node libs/encryption/src/scripts/encrypt-db-credentials.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@langchain/core": "^0.3.57",
    "@langchain/langgraph": "^0.2.73",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^3.0.3",
    "@nestjs/bullmq": "^10.2.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.1",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.11",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross": "^1.0.0",
    "env": "^0.0.2",
    "env-cmd": "^10.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "kafkajs": "^2.2.4",
    "langchain": "^0.3.27",
    "model-context-protocol": "^1.0.2",
    "moment": "^2.30.1",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm-extension": "^3.6.3",
    "winston": "^3.17.0",
    "winston-elasticsearch": "^0.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.17.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.1.3"
  }
}
