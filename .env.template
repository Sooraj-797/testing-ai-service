# Core Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_microservice_db
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

# Redis Configuration
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379
